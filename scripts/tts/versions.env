# Phiên bản ghim cho phần đọc giọng (VieNeu-TTS v3 Turbo). Một nguồn duy nhất:
# scripts/tts/models.py, .github/workflows/tts-smoke.yml và bước cài bộ đọc của
# phần mềm desktop (nhúng file này qua scripts/tts/embed.go) đều đọc file này.
# Định dạng KEY=VALUE, không dấu nháy, không khoảng trắng quanh dấu "=".

# Mã nguồn VieNeu-TTS (3.8.3) — cài bằng `uv sync --frozen` theo uv.lock của đúng commit này
VIENEU_REPO=https://github.com/pnnbao97/VieNeu-TTS
VIENEU_COMMIT=c1390abbdb2eedcdf58eafb546966c06ce27af71
# Phần mềm desktop tải tarball GitHub của commit trên (không cần git) rồi kiểm
# "tree hash" nội dung: sha256 của danh sách "<sha256 file>  <đường dẫn>" (sắp xếp
# theo đường dẫn) — không phụ thuộc cách GitHub nén lại tarball.
# Đổi VIENEU_COMMIT thì tính lại: cd desktop && SANO_PRINT_TREE_HASH=1 go test ./internal/setup -run TestPrintTreeHash -v
VIENEU_TREE_SHA256=fa7bf32635fe05435cb09ecb696dea04a66146d912fb66c040fcd9a39a60c92b

# Công cụ
UV_VERSION=0.11.14
PYTHON_VERSION=3.12
# SHA256 bản uv phần mềm desktop tải từ GitHub Release chính thức astral-sh/uv —
# chép từ file sha256.sum của release UV_VERSION. Đổi UV_VERSION thì chép lại.
UV_SHA256_AARCH64_APPLE_DARWIN=4333af5c0730d94323a7819bbdf87ce92dd07fc857d67fff0059e0fca31b5c02
UV_SHA256_X86_64_APPLE_DARWIN=9836c1440b0bd6aa5f81793648a339bd01d593b7b8f575de3b855dae4ab64654
UV_SHA256_X86_64_PC_WINDOWS_MSVC=52ba5d19409aaa688a8a1a6ec8dfb6a4817230d20186e75f4006105c3e39a846
UV_SHA256_AARCH64_PC_WINDOWS_MSVC=d66c76ba912ba66fed011e0189dfbc4527dd9e620a2b5d5d5ecd2ad8936601b8
UV_SHA256_X86_64_UNKNOWN_LINUX_GNU=f3b623eb0e6141a7053d571d59a0bdc341e0f238ea8f5f0b4815ddbec9a2a296
UV_SHA256_AARCH64_UNKNOWN_LINUX_GNU=c4958f729e216f1610632574ed927b8cf0af1bd02cb88cb30d948571727aee43

# ffmpeg (ghi MP3) — phần mềm desktop chỉ tải khi máy chưa có. Bản dựng tĩnh
# GPLv3, không bật --enable-nonfree nên được phân phối lại (đã kiểm chuỗi cấu hình
# trong từng file). Xem desktop/licenses/THIRD-PARTY-NOTICES.md.
# macOS: bản dựng của Martin Riedl (ffmpeg 9.0.2, file .zip chứa đúng 1 file ffmpeg)
FFMPEG_DARWIN_ARM64_URL=https://ffmpeg.martin-riedl.de/download/macos/arm64/1789931890_9.0.2/ffmpeg.zip
FFMPEG_DARWIN_ARM64_SHA256=c8ed4c4e6978a03c485edbfe4e0a5dc2380f8a30bba5150531b31b094492d924
FFMPEG_DARWIN_AMD64_URL=https://ffmpeg.martin-riedl.de/download/macos/amd64/1789931006_9.0.2/ffmpeg.zip
FFMPEG_DARWIN_AMD64_SHA256=7c6b4125b191cbf773832dc51f424cf2b6bb7da43007d1e066f95909e47cacd4
# Windows: bản gyan.dev 9.0.2 essentials (nguồn ffmpeg.org/download.html giới
# thiệu), release theo số phiên bản trên GitHub; SHA256 khớp mã gyan.dev công bố.
FFMPEG_WINDOWS_AMD64_URL=https://github.com/GyanD/codexffmpeg/releases/download/9.0.2/ffmpeg-9.0.2-essentials_build.zip
FFMPEG_WINDOWS_AMD64_SHA256=60f467265b1e312373dbcd92200c2618a74850f98d3d078e94296bb3fa2047ba
# Linux: bản BtbN 9.0.1 GPL (nguồn ffmpeg.org giới thiệu), bản dựng cuối tháng
# được giữ lâu dài; SHA256 khớp checksums.sha256 của release.
FFMPEG_LINUX_AMD64_URL=https://github.com/BtbN/FFmpeg-Builds/releases/download/autobuild-2026-08-31-13-27/ffmpeg-n9.0.1-11-ge47273f4d9-linux64-gpl-9.0.tar.xz
FFMPEG_LINUX_AMD64_SHA256=182c1b509720e939bb47bfb47dc29cc0c298640401128e3dce8627d10707eb5a
FFMPEG_LINUX_ARM64_URL=https://github.com/BtbN/FFmpeg-Builds/releases/download/autobuild-2026-08-31-13-27/ffmpeg-n9.0.1-11-ge47273f4d9-linuxarm64-gpl-9.0.tar.xz
FFMPEG_LINUX_ARM64_SHA256=e2dd447c8a47849c5812d87e54a47b20ae0f3603d38989440f4a5fe1af8755b1

# Model trên Hugging Face (revision = commit của repo model). Cả hai Apache-2.0,
# không khoá (gated) → không cần tài khoản / HF_TOKEN.
# Backbone v3 Turbo, đường ONNX/CPU fp32 (thư mục onnx_update/)
HF_BACKBONE_REPO=pnnbao-ump/VieNeu-TTS-v3-Turbo
HF_BACKBONE_REVISION=61b85e3d937fbbacb387714180e8182823512523
HF_BACKBONE_FILES=config.json,denoiser.onnx,onnx_update/config.json,onnx_update/tokenizer.json,onnx_update/vieneu_acoustic_cached.onnx,onnx_update/vieneu_backbone_shared.data,onnx_update/vieneu_decode_step.onnx,onnx_update/vieneu_prefill.onnx,onnx_update/vieneu_v3_heads.npz
# Codec MOSS (ONNX)
HF_CODEC_REPO=OpenMOSS-Team/MOSS-Audio-Tokenizer-Nano-ONNX
HF_CODEC_REVISION=ceff0d0749bfb3fa2d61149794ec6feef0d1e1ae
HF_CODEC_FILES=codec_browser_onnx_meta.json,moss_audio_tokenizer_decode_full.onnx,moss_audio_tokenizer_decode_shared.data,moss_audio_tokenizer_decode_step.onnx,moss_audio_tokenizer_encode.data,moss_audio_tokenizer_encode.onnx
